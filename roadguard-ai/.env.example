# RoadGuard AI — Environment Configuration

# Application
APP_NAME="RoadGuard AI — Smart Road Intelligence & Repair Tracking System"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Security
SECRET_KEY="roadguard-ai-secret-key-super-secure-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Local SQLite for seamless zero-setup demo & development
DATABASE_URL="sqlite:///./roadguard.db"
# Production MySQL Example:
# DATABASE_URL="mysql+pymysql://roadguard_user:yourpassword@localhost:3306/roadguard_db"

# Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=25

# AI & Computer Vision Service
YOLO_MODEL_PATH="./ml/weights/best.pt"
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
AI_FALLBACK_MODE=true

# Duplicate Detection Thresholds
DUPLICATE_DISTANCE_METERS=50.0
DUPLICATE_TIME_DAYS=30

# Google Gmail API OAuth 2.0 Integration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GMAIL_SENDER_EMAIL=your_sender_email@gmail.com

# External Integrations (Clearly labeled Demo / Production mode)
DEMO_MODE=true
OPENSTREETMAP_NOMINATIM_URL="https://nominatim.openstreetmap.org/reverse"
COPERNICUS_API_ENDPOINT="https://dataspace.copernicus.eu/resto/api"
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
PGPORTAL_INTEGRATION_MODE="demo_simulation"
PGPORTAL_API_KEY=""
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
GMAIL_APP_PASSWORD=""

# EmailJS Service Integration
EMAILJS_SERVICE_ID=service_6lrm73n
EMAILJS_TEMPLATE_ID=template_a3sgnoq
EMAILJS_PUBLIC_KEY=uSaF57l9OYZ3jQT5Z
